, "speaker": null, "conf": 1.0}, {"id": 26, "start": 95.154, "end": 98.615, "text": "ضع هاتفك بعيدا عن السرير بنصف ساعة على الأقل.", "words": [{"text": "ضع", "start": 95.154, "end": 95.341, "conf": 0.9, "speaker": null, "approx": true}, {"text": "هاتفك", "start": 95.341, "end": 95.809, "conf": 0.9, "speaker": null, "approx": true}, {"text": "بعيدا", "start": 95.809, "end": 96.276, "conf": 0.9, "speaker": null, "approx": true}, {"text": "عن", "start": 96.276, "end": 96.464, "conf": 0.9, "speaker": null, "approx": true}, {"text": "السرير", "start": 96.464, "end": 97.025, "conf": 0.9, "speaker": null, "approx": true}, {"text": "بنصف", "start": 97.025, "end": 97.399, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ساعة", "start": 97.399, "end": 97.773, "conf": 0.9, "speaker": null, "approx": true}, {"text": "على", "start": 97.773, "end": 98.054, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الأقل.", "start": 98.054, "end": 98.615, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 27, "start": 99.115, "end": 101.423, "text": "وستشعر بالفرق خلال أسبوع واحد فقط.", "words": [{"text": "وستشعر", "start": 99.115, "end": 99.593, "conf": 0.9, "speaker": null, "approx": true}, {"text": "بالفرق", "start": 99.593, "end": 100.07, "conf": 0.9, "speaker": null, "approx": true}, {"text": "خلال", "start": 100.07, "end": 100.388, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أسبوع", "start": 100.388, "end": 100.786, "conf": 0.9, "speaker": null, "approx": true}, {"text": "واحد", "start": 100.786, "end": 101.105, "conf": 0.9, "speaker": null, "approx": true}, {"text": "فقط.", "start": 101.105, "end": 101.423, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 28, "start": 101.923, "end": 104.615, "text": "باختصار النوم الجيد هو أساس كل إنجاز.", "words": [{"text": "باختصار", "start": 101.923, "end": 102.531, "conf": 0.9, "speaker": null, "approx": true}, {"text": "النوم", "start": 102.531, "end": 102.965, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الجيد", "start": 102.965, "end": 103.399, "conf": 0.9, "speaker": null, "approx": true}, {"text": "هو", "start": 103.399, "end": 103.573, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أساس", "start": 103.573, "end": 103.92, "conf": 0.9, "speaker": null, "approx": true}, {"text": "كل", "start": 103.92, "end": 104.094, "conf": 0.9, "speaker": null, "approx": true}, {"text": "إنجاز.", "start": 104.094, "end": 104.615, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 29, "start": 105.115, "end": 107.808, "text": "شكرا لكم وإلى اللقاء في الحلقة القادمة.", "words": [{"text": "شكرا", "start": 105.115, "end": 105.441, "conf": 0.9, "speaker": null, "approx": true}, {"text": "لكم", "start": 105.441, "end": 105.686, "conf": 0.9, "speaker": null, "approx": true}, {"text": "وإلى", "start": 105.686, "end": 106.013, "conf": 0.9, "speaker": null, "approx": true}, {"text": "اللقاء", "start": 106.013, "end": 106.502, "conf": 0.9, "speaker": null, "approx": true}, {"text": "في", "start": 106.502, "end": 106.666, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الحلقة", "start": 106.666, "end": 107.155, "conf": 0.9, "speaker": null, "approx": true}, {"text": "القادمة.", "start": 107.155, "end": 107.808, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}]}, "suggestions": [{"start": 0.85, "end": 32.942, "first_sentence": 0, "last_sentence": 8, "clip_type": "educational", "scores": {"hook": 0.7, "complete": 1.0, "value": 0.75, "audio": 0.96, "visual": 0.6, "engage": 0.544}, "penalties": {}, "total": 77.8, "reason_ar": "افتتاحية جاذبة، فكرة مكتملة بنهاية واضحة، قيمة معلوماتية واضحة، النوع: تعليمي", "title": "هل تعرف لماذا يفشل أغلب الناس في بناء…", "hooks": [{"type": "question", "text": "هل تعرف لماذا يفشل أغلب الناس في بناء عادة…"}], "emphasis": ["الاستمرار", "القراءة", "الحقيقي", "بصفحتين"], "speakers": [], "chapter": 0, "text": "هل تعرف لماذا يفشل أغلب الناس في بناء عادة القراءة؟ السبب ليس قلة الوقت كما يظنون. السبب الحقيقي أنهم يبدؤون بأهداف كبيرة جدا. مثلا يقول أحدهم سأقرأ كتابا كاملا كل أسبوع. وبعد ثلاثة أيام يتوقف تماما ويشعر بالذنب. الحل بسيط جدا، ابدأ بصفحتين فقط كل يوم. هذا لا يحتاج إلى قوة إرادة، وهذا هو السر. بعد شهر ستجد أنك قرأت ستين صفحة دون أن تشعر. الخلاصة أن الاستمرار أهم من الحجم دائما.", "flags": [], "duration": 32.092, "id": "c01", "rank": 1, "engine": "heuristic"}, {"start": 35.465, "end": 56.712, "first_sentence": 10, "last_sentence": 14, "clip_type": "educational", "scores": {"hook": 0.5, "complete": 1.0, "value": 0.85, "audio": 0.96, "visual": 0.6, "engage": 0.607}, "penalties": {}, "total": 76.7, "reason_ar": "فكرة مكتملة بنهاية واضحة، قيمة معلوماتية واضحة، النوع: تعليمي", "title": "أكبر خطأ في التوفير هو أن تدخر ما…", "hooks": [{"type": "statement", "text": "أكبر خطأ في التوفير هو أن تدخر ما يتبقى…"}], "emphasis": ["التوفير", "القاعدة", "الأفضل", "مباشرة"], "speakers": [], "chapter": 0, "text": "أكبر خطأ في التوفير هو أن تدخر ما يتبقى بعد الصرف. الأفضل أن تدخر أولا ثم تصرف ما بقي. لو كان راتبك عشرة آلاف فخصص ألفا مباشرة في أول الشهر. هذه القاعدة وحدها غيرت حياة كثير من الناس الذين أعرفهم. لأنك عندما تدخر أولا لن تشتاق لهذا المبلغ أبدا.", "flags": [], "duration": 21.247, "id": "c02", "rank": 2, "engine": "heuristic"}, {"start": 69.581, "end": 91.327, "first_sentence": 19, "last_sentence": 24, "clip_type": "educational", "scores": {"hook": 0.55, "complete": 1.0, "value": 0.691, "audio": 0.96, "visual": 0.6, "engage": 0.554}, "penalties": {}, "total": 73.7, "reason_ar": "فكرة مكتملة بنهاية واضحة، قيمة معلوماتية واضحة، النوع: تعليمي", "title": "ما الذي يحدث لجسمك عندما تنام أقل من…", "hooks": [{"type": "question", "text": "ما الذي يحدث لجسمك عندما تنام أقل من ست…"}], "emphasis": ["والمفاجأة", "الهرمونات", "بالاختلال", "والذاكرة"], "speakers": [], "chapter": 1, "text": "ما الذي يحدث لجسمك عندما تنام أقل من ست ساعات؟ أول شيء يتأثر هو التركيز والذاكرة. في إحدى الدراسات انخفض الأداء الذهني بنسبة أربعين بالمئة. والمفاجأة أن الناس لا يلاحظون هذا الانخفاض أبدا. ثم تبدأ الهرمونات بالاختلال وتزيد الشهية للسكريات. لذلك أفضل استثمار هو نوم سبع ساعات كل ليلة.", "flags": [], "duration": 21.746, "id": "c03", "rank": 3, "engine": "heuristic"}]}