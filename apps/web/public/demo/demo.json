31.663, "end": 31.821, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الحجم", "start": 31.821, "end": 32.217, "conf": 0.9, "speaker": null, "approx": true}, {"text": "دائما.", "start": 32.217, "end": 32.692, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 9, "start": 33.192, "end": 35.115, "text": "طيب خلونا ننتقل لموضوع ثاني.", "words": [{"text": "طيب", "start": 33.192, "end": 33.432, "conf": 0.9, "speaker": null, "approx": true}, {"text": "خلونا", "start": 33.432, "end": 33.833, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ننتقل", "start": 33.833, "end": 34.234, "conf": 0.9, "speaker": null, "approx": true}, {"text": "لموضوع", "start": 34.234, "end": 34.714, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ثاني.", "start": 34.714, "end": 35.115, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 10, "start": 35.615, "end": 39.846, "text": "أكبر خطأ في التوفير هو أن تدخر ما يتبقى بعد الصرف.", "words": [{"text": "أكبر", "start": 35.615, "end": 36.038, "conf": 0.9, "speaker": null, "approx": true}, {"text": "خطأ", "start": 36.038, "end": 36.355, "conf": 0.9, "speaker": null, "approx": true}, {"text": "في", "start": 36.355, "end": 36.567, "conf": 0.9, "speaker": null, "approx": true}, {"text": "التوفير", "start": 36.567, "end": 37.307, "conf": 0.9, "speaker": null, "approx": true}, {"text": "هو", "start": 37.307, "end": 37.519, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أن", "start": 37.519, "end": 37.731, "conf": 0.9, "speaker": null, "approx": true}, {"text": "تدخر", "start": 37.731, "end": 38.154, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ما", "start": 38.154, "end": 38.365, "conf": 0.9, "speaker": null, "approx": true}, {"text": "يتبقى", "start": 38.365, "end": 38.894, "conf": 0.9, "speaker": null, "approx": true}, {"text": "بعد", "start": 38.894, "end": 39.211, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الصرف.", "start": 39.211, "end": 39.846, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 11, "start": 40.346, "end": 43.423, "text": "الأفضل أن تدخر أولا ثم تصرف ما بقي.", "words": [{"text": "الأفضل", "start": 40.346, "end": 41.005, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أن", "start": 41.005, "end": 41.225, "conf": 0.9, "speaker": null, "approx": true}, {"text": "تدخر", "start": 41.225, "end": 41.665, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أولا", "start": 41.665, "end": 42.104, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ثم", "start": 42.104, "end": 42.324, "conf": 0.9, "speaker": null, "approx": true}, {"text": "تصرف", "start": 42.324, "end": 42.764, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ما", "start": 42.764, "end": 42.983, "conf": 0.9, "speaker": null, "approx": true}, {"text": "بقي.", "start": 42.983, "end": 43.423, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 12, "start": 43.923, "end": 48.154, "text": "لو كان راتبك عشرة آلاف فخصص ألفا مباشرة في أول الشهر.", "words": [{"text": "لو", "start": 43.923, "end": 44.12, "conf": 0.9, "speaker": null, "approx": true}, {"text": "كان", "start": 44.12, "end": 44.415, "conf": 0.9, "speaker": null, "approx": true}, {"text": "راتبك", "start": 44.415, "end": 44.907, "conf": 0.9, "speaker": null, "approx": true}, {"text": "عشرة", "start": 44.907, "end": 45.301, "conf": 0.9, "speaker": null, "approx": true}, {"text": "آلاف", "start": 45.301, "end": 45.694, "conf": 0.9, "speaker": null, "approx": true}, {"text": "فخصص", "start": 45.694, "end": 46.088, "conf": 0.9, "speaker": null, "approx": true}, {"text": "ألفا", "start": 46.088, "end": 46.481, "conf": 0.9, "speaker": null, "approx": true}, {"text": "مباشرة", "start": 46.481, "end": 47.072, "conf": 0.9, "speaker": null, "approx": true}, {"text": "في", "start": 47.072, "end": 47.268, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أول", "start": 47.268, "end": 47.564, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الشهر.", "start": 47.564, "end": 48.154, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 13, "start": 48.654, "end": 52.5, "text": "هذه القاعدة وحدها غيرت حياة كثير من الناس الذين أعرفهم.", "words": [{"text": "هذه", "start": 48.654, "end": 48.905, "conf": 0.9, "speaker": null, "approx": true}, {"text": "القاعدة", "start": 48.905, "end": 49.49, "conf": 0.9, "speaker": null, "approx": true}, {"text": "وحدها", "start": 49.49, "end": 49.908, "conf": 0.9, "speaker": null, "approx": true}, {"text": "غيرت", "start": 49.908, "end": 50.243, "conf": 0.9, "speaker": null, "approx": true}, {"text": "حياة", "start": 50.243, "end": 50.577, "conf": 0.9, "speaker": null, "approx": true}, {"text": "كثير", "start": 50.577, "end": 50.911, "conf": 0.9, "speaker": null, "approx": true}, {"text": "من", "start": 50.911, "end": 51.079, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الناس", "start": 51.079, "end": 51.497, "conf": 0.9, "speaker": null, "approx": true}, {"text": "الذين", "start": 51.497, "end": 51.915, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أعرفهم.", "start": 51.915, "end": 52.5, "conf": 0.9, "speaker": null, "approx": true}], "speaker": null, "conf": 1.0}, {"id": 14, "start": 53.0, "end": 56.462, "text": "لأنك عندما تدخر أولا لن تشتاق لهذا المبلغ أبدا.", "words": [{"text": "لأنك", "start": 53.0, "end": 53.355, "conf": 0.9, "speaker": null, "approx": true}, {"text": "عندما", "start": 53.355, "end": 53.799, "conf": 0.9, "speaker": null, "approx": true}, {"text": "تدخر", "start": 53.799, "end": 54.154, "conf": 0.9, "speaker": null, "approx": true}, {"text": "أولا", "start": 54.154, "end": 54.509, "conf": 0.9, "speaker": null, "approx": true}, {"text": "لن", "start": 54.509, "end": 54.687, "conf": 0.9, "speaker": null, "approx": true}, {"text": "تشتاق", "start": 54.687, "end": 55.13, "conf": 0.9, "speaker": null, "approx": true}, {"