# Copy to .env  (docker compose reads it for the api and worker services)

# No accounts / passwords / plans: each browser gets an anonymous random key (see docs/API.md).
# Put the API behind HTTPS; set RATE_LIMIT_PER_MIN to taste.

# --- AI providers ---------------------------------------------------------------------------
# Clip understanding / scoring: Claude. Without a key the offline heuristic judge is used (lower quality).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Transcription: faster-whisper (local; build with WITH_WHISPER=1) or openai-whisper (API key below) or none.
ASR_PROVIDER=faster-whisper
WHISPER_MODEL=large-v3
OPENAI_API_KEY=

# --- import from a link (yt-dlp) -------------------------------------------------------------
# Optional Netscape cookies file for sites that demand a login / bot check (e.g. YouTube from a datacenter IP).
YTDLP_COOKIES_FILE=

# --- limits & privacy -------------------------------------------------------------------------
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=180
RETENTION_DAYS=30
EXPORT_TTL_HOURS=72

# --- frontend (docker compose build arg) -------------------------------------------------------
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
